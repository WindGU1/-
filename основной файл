def add(a, b):
    return a + b

def subtract(a, b):
    return a - b

def multiply(a, b):
    return a * b

def divide(a, b):
    if b == 0:
        return "Ошибка: деление на ноль"
    return a / b

print("Сложение:", add(5, 3))
print("Вычитание:", subtract(5, 3))
print("Умножение:", multiply(5, 3))
print("Деление:", divide(5, 3))
